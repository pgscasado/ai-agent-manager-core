# Copy to .env (gitignored) for local development. Shell variables take precedence.

# --- Model providers (global keys; bots can override per provider) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# OLLAMA_URL=http://localhost:11434

# --- Dev shortcuts ---
# STORE=memory     # ETS instead of Postgres
# MODELS=fake      # offline fake models

# --- Postgres (dev) ---
# PGUSER=postgres
# PGPASSWORD=postgres
# PGHOST=localhost
# PGPORT=5432

# --- Production (set in the real environment, not here) ---
# DATABASE_URL=ecto://USER:PASS@HOST/agent_manager
# SECRET_KEY_BASE=   # mix phx.gen.secret
# PHX_HOST=api.example.com
# PHX_SERVER=true
