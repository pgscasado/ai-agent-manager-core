# Copy to .env (gitignored) for local development. Shell variables take precedence.
# Values are taken literally: keep comments on their own lines, never after a value.

# --- Model providers (global keys; bots can override per provider) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# OLLAMA_URL=http://localhost:11434

# Free-tier Gemini keys allow a few requests per minute; this paces calls instead of failing them
# GEMINI_RPM=5
# keep thinking (billed as output) minimal; Gemini 3 rejects "none" (2.5 only)
# GEMINI_REASONING_EFFORT=minimal

# --- Default models ("provider:model"; bots can set their own) ---
# DEFAULT_CHAT_MODEL=gemini:gemini-3.5-flash-lite
# DEFAULT_UTILITY_MODEL=
# DEFAULT_EMBEDDING_MODEL=ollama:embeddinggemma

# --- MCP servers (JSON array) ---
# MCP_SERVERS=[{"name":"crm","transport":"http","url":"https://crm.example.com/mcp"}]

# --- Dev shortcuts ---
# ETS instead of Postgres (no database needed; data is lost on restart)
# STORE=memory
# offline fake models
# MODELS=fake
# print events live on the console: messages in/out, pipeline steps, model and tool calls
# LIVE_TRACE=true
# PORT=4000

# --- Postgres (dev; needs the pgvector extension, e.g. docker compose up db) ---
# PGUSER=postgres
# PGPASSWORD=postgres
# PGHOST=localhost
# PGPORT=5432

# --- API auth and rate limits ---
# Bearer token for the API and /socket (production refuses to start without it)
# API_TOKEN=
# reverse proxy IPs whose X-Forwarded-For is trusted for the client IP (rate limits)
# TRUSTED_PROXIES=127.0.0.1,::1

# --- Spend cap (per UTC day, every caller together; unset = unlimited) ---
# MODEL_CALLS_DAILY=1000
# MODEL_TOKENS_DAILY=2000000
# separate budget for evaluation calls (budget: :qa)
# QA_CALLS_DAILY=300
# QA_TOKENS_DAILY=1000000

# --- Production (set in the real environment, not here) ---
# DATABASE_URL=ecto://USER:PASS@HOST/agent_manager
# mix phx.gen.secret
# SECRET_KEY_BASE=
# PHX_HOST=api.example.com
# PHX_SERVER=true
